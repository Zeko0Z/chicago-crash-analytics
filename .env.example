# =============================================================================
# Environment template - copy this file to ".env" and replace every value.
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows Command Prompt)
# NEVER commit the real .env file. It is listed in .gitignore.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=crash_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=chicago_crashes
# Port on YOUR computer. Change to 5433 if 5432 is already used.
POSTGRES_PORT=5432

# --- pgAdmin --------------------------------------------------------------
# Login for the pgAdmin web page (any valid-looking e-mail works locally)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_too
# Open pgAdmin at http://localhost:<PGADMIN_PORT>
PGADMIN_PORT=5050

# --- General ------------------------------------------------------------------
TZ=UTC
